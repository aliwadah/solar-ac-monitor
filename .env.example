# ============================================================
#  Solar AC Monitor - configuration reference
#  Used by monitor.py (GitHub Actions) and the local web app (solar_app.py)
#
#  On GitHub these become repository SECRETS / VARIABLES, NOT .env.
#  See .github/workflows/monitor.yml for how they map to secrets.
# ============================================================

# --- Battery (solar.siseli.com) ---
SISELI_USER=youraccount
SISELI_PASSWORD=yourpassword
SISELI_DEVICE_ID=485722267555168256

# --- Thresholds ---
ON_THRESHOLD=50     # manual turn-on requires battery >= this %
OFF_THRESHOLD=50    # auto turn-off when battery < this % while AC is on
ALERT_THRESHOLD=30  # send notification when battery < this %

# --- AC (TCL Home) ---
TCL_USER=your_tcl_home_email
TCL_PASSWORD=your_tcl_home_password
TCL_AC_NICKNAME=Split AC

# --- Notifications (ntfy.sh) ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=your_private_topic

# --- Manual action for a run (on / off / auto) ---
# In GitHub Actions this is set by the workflow_dispatch input; leave blank for auto.

# ------------------------------------------------------------------
# GITHUB SECRETS  (repo -> Settings -> Secrets and variables -> Actions)
#   These are encrypted and NOT shown to anyone:
#     SISELI_USER, SISELI_PASSWORD, SISELI_DEVICE_ID
#     TCL_USER, TCL_PASSWORD, TCL_AC_NICKNAME
#     NTFY_SERVER, NTFY_TOPIC
#
# GITHUB VARIABLES  (repo-level vars, plain text, not sensitive):
#     ON_THRESHOLD=50, OFF_THRESHOLD=50, ALERT_THRESHOLD=30
# ------------------------------------------------------------------